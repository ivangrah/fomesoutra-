# Copiez ce fichier en .env pour le développement local. Ne committez jamais .env.
DEBUG=true
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées à appeler l'API (adresse Vercel du front, puis domaine personnalisé).
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=

# Base de données : vide = SQLite locale ; en production, l'URL PostgreSQL de Render.
DATABASE_URL=

# Stockage des fichiers : local (dossier privé) ou s3 (stockage objet compatible S3).
STORAGE_BACKEND=local
MEDIA_ROOT=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_URL_EXPIRE_SECONDS=300

# Limites et jetons (valeurs proposées)
UPLOAD_MAX_MB_COURS=100
UPLOAD_MAX_MB_DEVOIR=50
UPLOAD_MAX_MB_EXAMEN=50
UPLOAD_MAX_MB_RENDU=50
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
THROTTLE_LOGIN=10/min
